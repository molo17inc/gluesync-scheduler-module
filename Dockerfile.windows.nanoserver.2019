# escape=`

# Use build argument to specify base tag for flexibility with default
ARG WINDOWS_TAG=ltsc2019

# ------------------
# Stage 1: Build exe (Server Core)
# ------------------
# Use the selected base image
FROM mcr.microsoft.com/dotnet/framework/sdk:4.8-windowsservercore-${WINDOWS_TAG} AS builder

# Use PowerShell for subsequent RUN commands, stop on errors
SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]

# Install Chocolatey package manager
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; `
  [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; `
  iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))

# Upgrade Chocolatey and install Python, Git, and clean cache
RUN choco upgrade chocolatey -y ; `
  choco install python --version=3.11.9 -y --installargs '"/quiet InstallAllUsers=1 PrependPath=1"'; `
  choco install git -y ; `
  choco install openssl.light -y ; `
  choco cache remove -y -f

# Restore the default Windows shell for correct batch processing.
SHELL ["cmd", "/S", "/C"]

RUN `
  # Download the Build Tools bootstrapper.
  curl -SL --output vs_buildtools.exe https://aka.ms/vs/16/release/vs_buildtools.exe `
  `
  # Install Build Tools with the Microsoft.VisualStudio.Workload.AzureBuildTools workload, excluding workloads and components with known issues.
  # https://learn.microsoft.com/en-us/visualstudio/install/workload-component-id-vs-build-tools?view=vs-2019
  && (start /w vs_buildtools.exe --quiet --wait --norestart --nocache `
  --installPath "%ProgramFiles(x86)%\Microsoft Visual Studio\2019\BuildTools" `
  --add Microsoft.VisualStudio.Component.VC.Tools.x86.x64 `
  --add Microsoft.VisualStudio.Component.Windows10SDK.19041 `
  || IF "%ERRORLEVEL%"=="3010" EXIT 0) `
  `
  # Cleanup
  && del /q vs_buildtools.exe

# Verify Python and Git installation
RUN python --version && `
  python -m pip --version && `
  git --version

# Make sure temp dir exists
RUN if not exist C:\temp mkdir C:\temp

WORKDIR C:\app

# Ensure directories exist
RUN if not exist C:\opt\gluesync\data mkdir C:\opt\gluesync\data && `
  if not exist C:\app\data mkdir C:\app\data && `
  if not exist C:\app\logs mkdir C:\app\logs

# Copy requirements
COPY requirements.txt .

# Verify Python installation, upgrade pip, install Python dependencies and install PyInstaller
RUN call "%ProgramFiles(x86)%\Microsoft Visual Studio\2019\BuildTools\VC\Auxiliary\Build\vcvars64.bat" && `
  python -m pip install --upgrade pip setuptools wheel && `
  python -m pip install --no-cache-dir -r requirements.txt `
  --extra-index-url "https://oauth2:${GITLAB_TOKEN}@gitlab.com/api/v4/projects/68232363/packages/pypi/simple" && `
  python -m pip install --no-cache-dir pyinstaller

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 `
  PYTHONUNBUFFERED=1 `
  PIP_DISABLE_PIP_VERSION_CHECK=1 `
  PYTHONUTF8=1 `
  PYTHONPATH=C:\app `
  GLUESYNC_LICENSE_FILE=C:\opt\gluesync\data\gs-license.dat `
  GLUESYNC_SECURITY_CONFIG=C:\opt\gluesync\data\security-config.json `
  GLUESYNC_USE_SSL=false `
  GLUESYNC_HOST= `
  DB_URL=sqlite:///C:/app/data/scheduler.db `
  ENTITY_START_TIMEOUT=2 `
  HOST=0.0.0.0 `
  PORT=1717 `
  DEBUG=False `
  LOG_LEVEL=INFO `
  LOG_DIR=C:\app\logs `
  CRON_LOG_DIR=C:\app\logs `
  DATA_DIR=C:\app\data `
  SSL_ENABLED=false `
  SSL_SKIP_VERIFY=True `
  TEMP=C:\temp `
  TMP=C:\temp `
  TIMEZONE=UTC `
  FIRE_ONCE=False

# Copy SDK
COPY ./gluesync-sdk ./gluesync-sdk

# Copy application files
COPY . .

# Ensure VERSION file exists (will be created by CI)
RUN if not exist VERSION (echo 0.0.0-dev > VERSION)

# Build EXE with PyInstaller (final step)
RUN pyinstaller `
  --onefile `
  --name GluesyncScheduler `
  --collect-all gluesync_scheduler `
  --add-data "gluesync-sdk;gluesync-sdk" `
  --add-data "data;data" `
  run_scheduler.py

# EXPOSE 1717
# # Create entrypoint script
# RUN echo @echo off > entrypoint.bat && `
#   echo echo Starting Gluesync Chronos Module... >> entrypoint.bat && `
#   echo python run_scheduler.py >> entrypoint.bat

# ENTRYPOINT ["entrypoint.bat"]
# # Alternative: keep container running for debugging
# # CMD ["powershell", "-Command", "while ($true) { Start-Sleep -Seconds 3600 }"]

# ------------------
# Stage 2: Runtime (Nano Server)
# ------------------
FROM mcr.microsoft.com/windows/nanoserver:${WINDOWS_TAG}

USER ContainerAdministrator

WORKDIR C:\app

# Copy only the generated exe
COPY --from=builder C:\app\dist\GluesyncScheduler.exe .

# If runtime static data is needed:
# COPY --from=builder C:\app\data C:\app\data

EXPOSE 1717

# Run only the exe
ENTRYPOINT ["C:\\app\\GluesyncScheduler.exe"]
