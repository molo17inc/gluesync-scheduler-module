# Use Python Windows image with build capabilities
FROM python:3.11-windowsservercore-ltsc2022

# Set working directory
WORKDIR C:/app

# Set environment variables for Python
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Set default Gluesync paths for Windows
ENV GLUESYNC_LICENSE_FILE=C:/opt/gluesync/data/gs-license.dat
ENV GLUESYNC_SECURITY_CONFIG=C:/opt/gluesync/data/security-config.json

# Create necessary directories
RUN md C:\opt\gluesync\data
RUN md C:\app\data
RUN md C:\app\logs

# Copy only the SDK submodule first
COPY ./gluesync-sdk ./gluesync-sdk

# Install specific websockets version first to avoid compatibility issues
RUN python -m pip install websockets==11.0.3

# Install the SDK
RUN cd ./gluesync-sdk; python -m pip install -e .

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN python -m pip install -r requirements.txt

# Copy application code
COPY gluesync_scheduler/ ./gluesync_scheduler/
COPY main.py .
COPY run_scheduler.py .
COPY setup.py .
COPY migrations/ ./migrations/

# Copy configuration files
COPY gs-license.dat C:/opt/gluesync/data/gs-license.dat
COPY security-config.json C:/opt/gluesync/data/security-config.json

# Set default environment variables for Windows
ENV DB_URL=sqlite:///C:/app/data/scheduler.db
ENV LOG_DIR=C:/app/logs
ENV CRON_LOG_DIR=C:/app/logs
ENV DATA_DIR=C:/app/data
ENV HOST=0.0.0.0
ENV PORT=8000
ENV SSL_ENABLED=false
ENV GLUESYNC_MODULE_TAG=scheduler-module
ENV GLUESYNC_USE_SSL=false

# Windows-specific path environment variables
ENV PYTHONPATH=C:/app
ENV TEMP=C:/temp
ENV TMP=C:/temp

# Expose port
EXPOSE 8000

# Health check using Python instead of PowerShell
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; import os; url = 'http://' + os.environ.get('HOST', 'localhost') + ':8000/health'; urllib.request.urlopen(url)" || exit 1

# Create entrypoint script using PowerShell to ensure proper line endings
RUN powershell -Command "Set-Content -Path entrypoint.bat -Value '@echo off'" && \
    powershell -Command "Add-Content -Path entrypoint.bat -Value 'echo Starting Gluesync Chronos Module...'" && \
    powershell -Command "Add-Content -Path entrypoint.bat -Value 'python run_scheduler.py'"

# Set entrypoint
ENTRYPOINT ["entrypoint.bat"]
