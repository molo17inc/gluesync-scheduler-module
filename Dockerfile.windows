# escape=`

# Use build argument to specify base tag for flexibility with default
ARG WINDOWS_TAG=ltsc2022

# ------------------
# Stage 1: Build exe (Server Core)
# ------------------
FROM molo17/python:3.11.9-win-servercore-${WINDOWS_TAG} AS builder

# Switch to Windows shell
SHELL ["cmd", "/S", "/C"]

# Make sure temp dir exists
RUN if not exist C:\temp mkdir C:\temp

WORKDIR C:\app

# Ensure directories exist
RUN if not exist C:\opt\gluesync\data mkdir C:\opt\gluesync\data && `
  if not exist C:\opt\gluesync\shared mkdir C:\opt\gluesync\shared && `
  if not exist C:\app\data mkdir C:\app\data && `
  if not exist C:\app\logs mkdir C:\app\logs

# Copy requirements
COPY requirements.txt .

# Verify Python installation, upgrade pip, install Python dependencies and install PyInstaller
RUN if /I "%WINDOWS_TAG%"=="ltsc2019" ( `
  call "%ProgramFiles(x86)%\Microsoft Visual Studio\2019\BuildTools\VC\Auxiliary\Build\vcvars64.bat" `
  ) else ( `
  echo Skipping vcvars64 on %WINDOWS_TAG% `
  ) && `
  python -m pip install --upgrade pip setuptools wheel && `
  python -m pip install --no-cache-dir -r requirements.txt `
  --extra-index-url "https://oauth2:${GITLAB_TOKEN}@gitlab.com/api/v4/projects/68232363/packages/pypi/simple" && `
  python -m pip install --no-cache-dir pyinstaller

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 `
  PYTHONUNBUFFERED=1 `
  PIP_DISABLE_PIP_VERSION_CHECK=1 `
  PYTHONUTF8=1 `
  PYTHONPATH=C:\app `
  GLUESYNC_LICENSE_FILE=C:\opt\gluesync\shared\gs-license.dat `
  GLUESYNC_SECURITY_CONFIG=C:\opt\gluesync\shared\security-config.json `
  GLUESYNC_HOST= `
  DB_URL=sqlite:///C:/app/data/scheduler.db `
  ENTITY_START_TIMEOUT=2 `
  HOST=0.0.0.0 `
  PORT=1717 `
  DEBUG=false `
  LOG_LEVEL=INFO `
  LOG_DIR=C:\app\logs `
  CRON_LOG_DIR=C:\app\logs `
  DATA_DIR=C:\app\data `
  SSL_ENABLED=false `
  SSL_SKIP_VERIFY=true `
  TEMP=C:\temp `
  TMP=C:\temp `
  TIMEZONE=UTC `
  FIRE_ONCE=false

# Copy SDK
COPY ./gluesync-sdk ./gluesync-sdk

# Copy VERSION file explicitly (created by CI)
COPY VERSION .

# Copy application files
COPY . .

# Ensure VERSION file exists (will be created by CI)
RUN if not exist VERSION (echo 0.0.0-dev > VERSION)

# Build EXE with PyInstaller (final step)
RUN pyinstaller `
  --onefile `
  --name GluesyncScheduler `
  --collect-all gluesync_scheduler `
  --add-data "gluesync-sdk;gluesync-sdk" `
  --add-data "data;data" `
  run_scheduler.py

# EXPOSE 1717
# # Create entrypoint script
# RUN echo @echo off > entrypoint.bat && `
#   echo echo Starting Gluesync Chronos Module... >> entrypoint.bat && `
#   echo python run_scheduler.py >> entrypoint.bat

# ENTRYPOINT ["entrypoint.bat"]
# # Alternative: keep container running for debugging
# # CMD ["powershell", "-Command", "while ($true) { Start-Sleep -Seconds 3600 }"]

# ------------------
# Stage 2: Runtime (Nano Server)
# ------------------
FROM mcr.microsoft.com/windows/nanoserver:${WINDOWS_TAG}

USER ContainerAdministrator

WORKDIR C:\app

# Set runtime environment variables (separate from build stage)
ENV PYTHONDONTWRITEBYTECODE=1 `
  PYTHONUNBUFFERED=1 `
  PYTHONPATH=C:\app `
  PROJECT_ROOT=C:\app `
  GLUESYNC_LICENSE_FILE=C:\opt\gluesync\shared\gs-license.dat `
  GLUESYNC_SECURITY_CONFIG=C:\opt\gluesync\shared\security-config.json `
  GLUESYNC_HOST= `
  DB_URL=sqlite:///C:/app/data/scheduler.db `
  ENTITY_START_TIMEOUT=2 `
  HOST=0.0.0.0 `
  PORT=1717 `
  DEBUG=false `
  LOG_LEVEL=INFO `
  LOG_DIR=C:\app\logs `
  CRON_LOG_DIR=C:\app\logs `
  DATA_DIR=C:\app\data `
  SSL_ENABLED=false `
  SSL_SKIP_VERIFY=true `
  TEMP=C:\temp `
  TMP=C:\temp `
  TIMEZONE=UTC `
  FIRE_ONCE=false

# Copy only the generated exe
COPY --from=builder C:\app\dist\GluesyncScheduler.exe .

# Copy migrations directory for runtime migration execution
COPY --from=builder C:\app\migrations ./migrations

# If runtime static data is needed:
# COPY --from=builder C:\app\data C:\app\data

EXPOSE 1717

# Run only the exe
ENTRYPOINT ["C:\\app\\GluesyncScheduler.exe"]
