# escape=`

# Base image Windows Server Core LTSC2022
FROM mcr.microsoft.com/windows/servercore:ltsc2022

# Use PowerShell for subsequent RUN commands, stop on errors
SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]

# Install Chocolatey package manager
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; `
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; `
    iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))

# Upgrade Chocolatey and install Python, Git, and clean cache
RUN choco upgrade chocolatey -y ; `
    choco install python --version=3.11.9 -y --installargs '"/quiet InstallAllUsers=1 PrependPath=1"'; `
    choco install git -y ; `
    choco cache remove -y -f

# Restore the default Windows shell for correct batch processing.
SHELL ["cmd", "/S", "/C"]

RUN `
    # Download the Build Tools bootstrapper.
    curl -SL --output vs_buildtools.exe https://aka.ms/vs/17/release/vs_buildtools.exe `
    `
    # Install Build Tools with the Microsoft.VisualStudio.Workload.AzureBuildTools workload, excluding workloads and components with known issues.
    && (start /w vs_buildtools.exe --quiet --wait --norestart --nocache `
    --installPath "%ProgramFiles(x86)%\Microsoft Visual Studio\2022\BuildTools" `
    # --add Microsoft.VisualStudio.Workload.VCTools `
    --add Microsoft.Component.MSBuild `
    --add Microsoft.VisualStudio.Component.VC.Tools.x86.x64 `
    --add Microsoft.Component.VC.Runtime.UCRTSDK `
    # --add Microsoft.VisualStudio.Component.Windows10SDK.19041 `
    || IF "%ERRORLEVEL%"=="3010" EXIT 0) `
    `
    # Cleanup
    && del /q vs_buildtools.exe

# Verify Python and Git installation
RUN python --version && `
    python -m pip --version && `
    git --version

WORKDIR C:/app

# Ensure directories exist
RUN if not exist C:\opt\gluesync\data mkdir C:\opt\gluesync\data && `
    if not exist C:\app\data mkdir C:\app\data && `
    if not exist C:\app\logs mkdir C:\app\logs

# Copy requirements and install dependencies
COPY requirements.txt .

# Verify Python installation and upgrade pip
# Upgrade pip and install Python dependencies
RUN python -m pip install --upgrade pip setuptools wheel && `
    python -m pip install --no-cache-dir -r requirements.txt `
    --extra-index-url "https://oauth2:${GITLAB_TOKEN}@gitlab.com/api/v4/projects/68232363/packages/pypi/simple"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV GLUESYNC_LICENSE_FILE=C:/opt/gluesync/data/gs-license.dat
ENV GLUESYNC_SECURITY_CONFIG=C:/opt/gluesync/data/security-config.json
ENV DB_URL=sqlite:///C:/app/data/scheduler.db
ENV LOG_DIR=C:/app/logs
ENV CRON_LOG_DIR=C:/app/logs
ENV DATA_DIR=C:/app/data
ENV HOST=0.0.0.0
ENV PORT=8000
ENV SSL_ENABLED=false
ENV GLUESYNC_MODULE_TAG=scheduler-module
ENV GLUESYNC_USE_SSL=false
ENV PYTHONPATH=C:/app
ENV TEMP=C:/temp
ENV TMP=C:/temp

# Copy SDK
COPY ./gluesync-sdk ./gluesync-sdk

# Copy application code and configurations
COPY gluesync_scheduler/ ./gluesync_scheduler/
COPY main.py .
COPY run_scheduler.py .
COPY setup.py .
COPY migrations/ ./migrations/
COPY gs-license.dat C:/opt/gluesync/data/gs-license.dat
COPY security-config.json C:/opt/gluesync/data/security-config.json

EXPOSE 8000

# Healthcheck endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 `
    CMD python -c "import urllib.request, os; url='http://'+os.environ.get('HOST','localhost')+':8000/health'; urllib.request.urlopen(url)" || exit 1

# Create entrypoint script
RUN echo @echo off > entrypoint.bat && `
    echo echo Starting Gluesync Chronos Module... >> entrypoint.bat && `
    echo python run_scheduler.py >> entrypoint.bat

ENTRYPOINT ["entrypoint.bat"]
# Alternative: keep container running for debugging
# CMD ["powershell", "-Command", "while ($true) { Start-Sleep -Seconds 3600 }"]
